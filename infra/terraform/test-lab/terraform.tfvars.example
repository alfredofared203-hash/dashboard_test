# Copy to terraform.tfvars and customize for a reviewed environment.
# This example contains public configuration only; never add credentials or secrets.

aws_region      = "eu-north-1"
project_name    = "DCC-TestLab"
environment_name = "lab"
name_prefix     = "dcc-testlab"

vpc_cidr = "10.80.0.0/16"

# Use AZ names, not account-specific AZ IDs. Empty selects the first two available AZs.
availability_zones = ["eu-north-1a", "eu-north-1b"]

public_subnet_cidrs = [
  "10.80.0.0/24",
  "10.80.1.0/24",
]

private_application_subnet_cidrs = [
  "10.80.16.0/20",
  "10.80.32.0/20",
]

private_data_subnet_cidrs = [
  "10.80.48.0/24",
  "10.80.49.0/24",
]

enable_nat_gateway       = true
ecr_repository_name      = "dcc-testlab-app"
cloud_map_namespace_name = "dcc-test.internal"
cloud_map_service_name   = "dcc-test-api"

common_tags = {
  Owner = "replace-with-owner"
}
