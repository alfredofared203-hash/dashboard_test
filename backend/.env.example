# Example values only. Do not use these as production secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins allowed to call the frontend-backed API routes.
DCC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ECS discovery is AWS-only. Set real values for the intended AWS environment.
# AWS_REGION=<aws-region>
# DCC_ECS_CLUSTERS=<existing-workload-cluster-name-or-arn>[,...]
DCC_DIAGNOSTIC_PROVIDER=inmemory
# Process-local diagnostic safeguards (defaults are safe for development).
DCC_DIAGNOSTIC_MAX_DURATION_SECONDS=900
DCC_DIAGNOSTIC_MAX_ACTIVE_SESSIONS=1
DCC_DIAGNOSTIC_START_RATE_LIMIT=3
DCC_DIAGNOSTIC_START_RATE_WINDOW_SECONDS=3600
DCC_DIAGNOSTIC_STOP_RATE_LIMIT=10
DCC_DIAGNOSTIC_STOP_RATE_WINDOW_SECONDS=60
DCC_DIAGNOSTIC_TARGET_COOLDOWN_SECONDS=0
DCC_METRICS_PROVIDER=cloudwatch
DCC_DEPENDENCIES_PROVIDER=cloudwatch
# DCC_DEPENDENCY_RESOURCES is a backend-only JSON array for the CloudWatch provider.
# Example: [{"resource_type":"rds","resource_id":"orders-db","engine":"postgres"},
# {"resource_type":"elasticache","resource_id":"sessions-cache","engine":"redis",
# "resource_scope":"cache_cluster"}]
DCC_DEPENDENCY_RESOURCES=[]

# CloudWatch metrics use the dimensions/namespaces for an existing ECS service. AWS
# credentials are read from boto3's normal credential chain, never this file.
# DCC_CLOUDWATCH_REGION=us-east-1
# DCC_CLOUDWATCH_CLUSTER_NAME=replace-with-existing-cluster
# DCC_CLOUDWATCH_SERVICE_NAME=replace-with-existing-service
# DCC_CLOUDWATCH_ECS_NAMESPACE=AWS/ECS
# DCC_CLOUDWATCH_CONTAINER_INSIGHTS_NAMESPACE=ECS/ContainerInsights
# Dependency CloudWatch uses the same region setting and boto3 credential chain.
# Set DCC_DEPENDENCIES_PROVIDER=cloudwatch and configure resource identifiers above.

# Production deployment values (set via ECS environment or Secrets Manager).
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=replace-with-strong-secret
# DJANGO_ALLOWED_HOSTS=app.example.com
# DCC_CORS_ALLOWED_ORIGINS=https://app.example.com
# PORT=8000
# DCC_DIAGNOSTIC_PROVIDER=ecs
# DCC_METRICS_PROVIDER=cloudwatch
# DCC_LOGS_PROVIDER=loki
# DCC_DEPENDENCIES_PROVIDER=cloudwatch

# Prometheus is disabled by default. When selected, the endpoint must expose
# DCC task metrics with a task_id label. Credentials are not accepted in the URL.
# DCC_PROMETHEUS_URL=http://localhost:9090

# Logs default to Loki. Configure a reachable Loki base URL for live log retrieval.
# Optional bearer token and tenant ID are backend-only deployment secrets/settings.
# DCC_LOGS_PROVIDER=loki
# DCC_LOKI_URL=<approved-internal-loki-url>
# DCC_LOKI_BEARER_TOKEN=
# DCC_LOKI_TENANT_ID=

# ECS diagnostic worker execution is disabled by default. Discovery always uses
# AWS ECS APIs for the explicitly configured DCC_ECS_CLUSTERS above.
# Configure these only when selecting DCC_DIAGNOSTIC_PROVIDER=ecs.
# Do not put AWS credentials in this file.
# DCC_ECS_CLUSTER=replace-with-existing-cluster
# DCC_ECS_TASK_DEFINITION=replace-with-existing-task-definition
# DCC_ECS_SUBNETS=subnet-1,subnet-2
# DCC_ECS_SECURITY_GROUPS=sg-1
# DCC_ECS_CONTAINER_NAME=diagnostic-worker
# DCC_ECS_ASSIGN_PUBLIC_IP=false
# Maximum resources allowed by the configured ECS worker task definition.
# DCC_ECS_MAX_TASK_CPU=1024
# DCC_ECS_MAX_TASK_MEMORY_MIB=2048
